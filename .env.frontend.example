# Only PUBLIC Firebase Web SDK identifiers. NEVER put Google OAuth client secret, Groq API key, encryption key, or FCM service-account JSON here.
VITE_FIREBASE_API_KEY=YOUR_PUBLIC_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_WEB_APP_ID
VITE_FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=YOUR_PUBLIC_WEB_PUSH_VAPID_KEY
