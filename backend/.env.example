# Copy to backend/.env and fill in locally. Never commit .env.
NODE_ENV=development
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
BASE_URL=http://localhost:8787
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
ALLOWED_GMAIL_ADDRESS=your-address@gmail.com
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY_B64=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
DB_PATH=./private/lifepilot.sqlite
# Set true ONLY behind your trusted HTTPS reverse proxy
TRUST_PROXY=false
# Legacy mode label; real state comes from /api/monitoring and the scheduler flags below.
MONITORING_MODE=manual

# MODULE 3 - GROQ CLOUD (NOT xAI GROK). Put actual key ONLY in local backend/.env or secret manager.
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
AI_ENABLED=false
AI_MAX_INPUT_CHARS=18000
AI_MAX_OUTPUT_TOKENS=850
AI_TIMEOUT_MS=18000

# MODULE 4 — OPTIONAL CLOUD SCHEDULED MONITORING
# Set both only after a real HTTPS scheduler AND persistent backend are deployed.
MONITOR_WORKER_ENABLED=false
MONITOR_CRON_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_32_BYTE_SECRET
# Firebase FCM HTTP v1: base64 of JSON service account; backend secret ONLY.
# Empty disables push, safely. Use secrets manager, never commit private JSON.
FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# Optional local scheduler on a single persistent cloud VM; do not enable on a laptop
MONITOR_INTERNAL_TIMER_ENABLED=false
MONITOR_POLL_INTERVAL_MS=900000
# Automatic AI triage is OFF until independently enabled in Settings after consent.
# Per-account automatic draft limits are 1-25 per UTC day; review potential model costs.
# Automatic review processes up to 3 queued emails per monitoring cycle (maximum 5).
AUTO_AI_BATCH_SIZE=3
