# Copy privately to cloud/oracle/.env. DO NOT commit .env or upload screenshots.
NODE_ENV=production
PORT=8787
TRUST_PROXY=true
# Must match the HTTPS domain configured in Caddyfile, without a trailing slash
BASE_URL=https://example.invalid
FRONTEND_ORIGIN=https://example.invalid
GOOGLE_REDIRECT_URI=https://example.invalid/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
ALLOWED_GMAIL_ADDRESS=owner@example.com
TOKEN_ENCRYPTION_KEY_B64=REPLACE_WITH_32_BYTE_RANDOM_BASE64
# Mandatory persistent bind mount. Never use /app/private or any ephemeral container path.
DB_PATH=/srv/lifepilot/lifepilot.sqlite
AI_PROVIDER=groq
AI_ENABLED=false
GROQ_API_KEY=YOUR_PRIVATE_GROQ_KEY
GROQ_MODEL=openai/gpt-oss-20b
AI_MAX_INPUT_CHARS=18000
AI_MAX_OUTPUT_TOKENS=850
AI_TIMEOUT_MS=18000
# Enable only once Cloudflare cron is deployed and the DB is persistent.
MONITOR_WORKER_ENABLED=false
MONITOR_CRON_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_MIN_32_CHARS
FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# Alternative to Cloudflare Cron on ONE continuously running persistent VM:
# This timer belongs to the VM, not your personal PC. Enable only on deployed VM.
MONITOR_INTERNAL_TIMER_ENABLED=false
MONITOR_POLL_INTERVAL_MS=900000
# 1-5 eligible messages processed per check (provider limits/costs still apply).
AUTO_AI_BATCH_SIZE=3
